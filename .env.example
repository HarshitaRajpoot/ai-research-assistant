# All keys below are OPTIONAL server-side defaults.
# This app is designed to let each user paste their own Serper.dev and
# OpenRouter keys into the in-app Settings panel (stored only in the
# browser's localStorage, never sent anywhere except this server).
#
# Setting them here as well just gives a fallback so the server-side
# API routes work even if a visitor hasn't opened Settings yet.

SERPER_API_KEY=
OPENROUTER_API_KEY=

# Optional: lets the Discord settings panel auto-fill so testers do not
# have to paste the token/channel every time. Still overridable in-app.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
